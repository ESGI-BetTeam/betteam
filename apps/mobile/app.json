{
  "expo": {
    "name": "BetTeam",
    "slug": "betteam",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B0F1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.betteam.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A"
      },
      "package": "com.betteam.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "BetTeam utilise vos photos pour définir le logo de votre ligue."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "82ec6538-3c53-43b2-925b-d60df03cbc22"
      }
    },
    "owner": "neoznzoe"
  }
}
